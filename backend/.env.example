# Market data — free keys:
#   https://finnhub.io/register        (symbols, profile, quote, news, earnings)
#   https://twelvedata.com/pricing     (daily price history; Finnhub candles are paid-only)
FINNHUB_API_KEY=
TWELVEDATA_API_KEY=
# Requests per minute; raise on a paid plan.
FINNHUB_RATE_PER_MIN=60
TWELVEDATA_RATE_PER_MIN=8

# Claude — https://platform.claude.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# Cost protection for AI analyses (0 disables a limit)
ANALYZE_LIMIT_PER_HOUR=5
ANALYZE_LIMIT_PER_DAY=100
ANALYSIS_CACHE_HOURS=12

# Unusual-move detection
MOVE_Z_THRESHOLD=2.0
MAX_MOVES_TO_EXPLAIN=6

# LangSmith tracing (optional) — https://smith.langchain.com
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=tickwhy
# EU-region accounts: https://eu.api.smith.langchain.com
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

CORS_ORIGINS=["http://localhost:3000"]
